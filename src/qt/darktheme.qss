/* Общий фон */
QWidget {
    background-color: #121212;
    color: #E0E0E0;
    font-family: 'Segoe UI', sans-serif;
    font-size: 12pt;
}

/* Кнопки */
QPushButton {
    background-color: #1E1E1E;
    color: #E0E0E0;
    border: 1px solid #3A3A3A;
    border-radius: 6px;
    padding: 6px 12px;
    qproperty-iconSize: 16px; /* Размер иконки */
}
QPushButton::menu-indicator {
    image: none;
}

QPushButton:hover {
    background-color: #2A2A2A;
}
QPushButton:pressed {
    background-color: #333333;
}

/* Поля ввода */
QLineEdit {
    background-color: #1E1E1E;
    color: #E0E0E0;
    border: 1px solid #3A3A3A;
    border-radius: 6px;
    padding: 4px;
}

/* Текстовый браузер */
QTextBrowser {
    background-color: #1E1E1E;
    color: #FFFFFF;
    border: 1px solid #3A3A3A;
    border-radius: 6px;
}

/* Меню */
QMenuBar {
    background-color: #1E1E1E;
    color: #E0E0E0;
}
QMenuBar::item {
    background-color: #1E1E1E;
    color: #E0E0E0;
}
QMenuBar::item:selected {
    background-color: #333333;
}

/* Статус-бар */
QStatusBar {
    background-color: #1E1E1E;
    color: #E0E0E0;
}
